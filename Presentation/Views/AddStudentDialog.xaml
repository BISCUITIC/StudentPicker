<Window x:Class="Presentation.Views.AddStudentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Student" Height="200" Width="300">
    <StackPanel Margin="10">
        <TextBox x:Name="FirstNameTextBox" Margin="0,0,0,10"
                 Text="{Binding Name}"/>
        <TextBox x:Name="LastNameTextBox" Margin="0,0,0,10"
                 Text="{Binding SecondName}"/>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="70"
                    Command="{Binding SaveCommand}"/>
            <Button Content="Cancel" Width="70" 
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
