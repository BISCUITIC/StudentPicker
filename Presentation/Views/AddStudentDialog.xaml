<Window x:Class="Presentation.Views.AddStudentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"        
        Title="Add Student"       
        Style="{StaticResource DialogWindowStyle}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Buttons/DialogButtonStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="10">
        <TextBox x:Name="FirstNameTextBox" Margin="0,0,0,10"
                 Text="{Binding Name}"/>
        <TextBox x:Name="LastNameTextBox" Margin="0,0,0,10"
                 Text="{Binding SecondName}"/>
        
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center">
            <Button Content="Save"
                    Style="{StaticResource DialogButtonStyle}"
                    Command="{Binding SaveCommand}"/>
            <Button Content="Cancel" 
                    Style="{StaticResource DialogButtonStyle}"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
    
</Window>
