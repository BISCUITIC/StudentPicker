<Window x:Class="Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentation"           
        mc:Ignorable="d"  
        x:Name="CoreWindow"
        Style="{StaticResource WindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1.2*"></RowDefinition>
            <RowDefinition Height="12*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <ItemsControl Grid.Row="0" x:Name="GroupList"
                      Background="#FF2E2E2E"
                      ItemsSource="{Binding GroupsViewModel.Groups}"
                      ItemsPanel="{StaticResource GroupItemPanel}"
                      ItemTemplate="{StaticResource GroupItemTemplate}"/>

        <ItemsControl Grid.Row="1" x:Name="StudentList"
                      ItemsSource="{Binding StudentsViewModel.Students}"
                      ItemsPanel="{StaticResource StudentItemPanel}"
                      ItemTemplate="{StaticResource StudentItemTemplate}"/>

        <DockPanel Grid.Row="2" >
            <Button x:Name="AddButton" DockPanel.Dock="Right"
                    Content="+"
                    Style="{StaticResource AddButtonStyle}"
                    Command="{Binding StudentsViewModel.AddStudentCommand}"/>
            <TextBlock x:Name="Statebar" DockPanel.Dock="Left"
                       Text="{Binding Path=StudentsViewModel.State,
                                      Mode=OneWay,
                                      UpdateSourceTrigger=PropertyChanged}" 
                       Foreground="White"/>
        </DockPanel>
        <DockPanel Grid.Row="3">
            <Button x:Name="RandomButton" 
                    Content="Random"
                    Style="{StaticResource RandomButtonStyle}"/>
        </DockPanel>
    </Grid>
</Window>
