<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Presentation.AttachedProperties">
    
    <Style TargetType="Button" 
           x:Key="RandomButtonStyle"
           BasedOn="{StaticResource DefualtButtonStyle}">

        <Setter Property="Margin" Value="40,7,40,7"/>
        <Setter Property="local:ButtonProperties.CornerRadius" Value="7"/>
        
    </Style>
    
</ResourceDictionary>