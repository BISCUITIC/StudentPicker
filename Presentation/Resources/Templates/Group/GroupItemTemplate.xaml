<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Styles/Buttons/GroupButtonStyle.xaml"/>
    </ResourceDictionary.MergedDictionaries>              
    
    <DataTemplate x:Key="GroupItemTemplate">
        <Button Style="{StaticResource ResourceKey=GroupButtonStyle}"
                Command="{Binding DataContext.StudentsViewModel.LoadStudentsCommand,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}">

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Path=Number}"/>
                <TextBlock Text="{Binding Path=Letter}"/>
            </StackPanel>
        </Button>
    </DataTemplate>
    
</ResourceDictionary>