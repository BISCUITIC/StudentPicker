<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="http://schemas.microsoft.com/xaml/behaviors">

    <Style TargetType="Border" x:Key="StudentPanelBorderStyle">
        <Style.Setters>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="2"/>
        </Style.Setters>

        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=IsExcluded}" Value="False">
                <Setter Property="Background" Value="#FF313131"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding Path=IsExcluded}" Value="True">
                <Setter Property="Background" Value="#FFB20000"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBlock" x:Key="StudentTextBlockStyle">
        <Style.Setters>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#FF313131" />
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="25"/>
        </Style.Setters>
    </Style>

    <DataTemplate x:Key="StudentItemTemplate">
        <Border Name="StudenItemPanelBorder"
                Style="{StaticResource StudentPanelBorderStyle}">

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseLeftButtonDown">
                    <i:InvokeCommandAction Command="{Binding ToggleExludedCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>

            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding DeleteStudentCommand}"
                              Header="Delete"/>
                    <MenuItem Command="{Binding UpdateStudentCommand}"
                              Header="Edit"/>
                </ContextMenu>
            </Border.ContextMenu>

            <StackPanel Orientation="Horizontal" 
                        Background="{Binding ElementName=StudentItemTemplate, Path=Background}"                                
                        Tag="{Binding ElementName=CoreWindow}">
                
                <TextBlock Style="{StaticResource ResourceKey=StudentTextBlockStyle}" 
                           Text="{Binding Path=Student.Name}"
                           Background="{Binding ElementName=StudentItemTemplate, Path=Background}" >
                </TextBlock>

                <TextBlock Style="{StaticResource ResourceKey=StudentTextBlockStyle}" 
                           Text="{Binding Path=Student.SecondName}"
                           Background="{Binding ElementName=StudentItemTemplate, Path=Background}" >
                </TextBlock>
                
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>